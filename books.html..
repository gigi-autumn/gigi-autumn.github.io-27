</head>

<body>

  <div class="top-note">
    THE WITTY MUSE — THE BOOK SHELF ♡
  </div>


  <!-- HEADER -->

  <header>

    <a href="index.html" class="logo">
      <span>THE</span>
      WITTY MUSE
      <small>EST. 2026</small>
    </a>

    <nav>
      <a href="index.html">HOME</a>
      <a href="about.html">ABOUT</a>
      <a href="diary.html">DIARY</a>
      <a href="fashion.html">FASHION</a>
