* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --pink: #e9bfc9;
  --dark-pink: #a85f72;
  --cream: #fbf6f0;
  --vanilla: #f3e7dc;
  --brown: #493c3b;
  --soft-brown: #756765;
  --line: #d9cdc5;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--cream);
  color: var(--brown);
  font-family: 'Montserrat', sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}


/* TOP */

.top-note {
  background: var(--brown);
  color: var(--cream);
  text-align: center;
  padding: 9px;
  font-size: 9px;
  letter-spacing: 3px;
}


/* HEADER */

header {
  padding: 35px 6%;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.logo {
  font-family: 'DM Serif Display', serif;
  font-size: 29px;
  letter-spacing: 2px;
  text-align: center;
  line-height: .9;
}

.logo span {
  display: block;
  font-family: 'Montserrat', sans-serif;
  font-size: 8px;
  letter-spacing: 5px;
  margin-bottom: 7px;
}

.logo small {
  display: block;
  font-family: 'Montserrat', sans-serif;
  font-size: 7px;
  letter-spacing: 3px;
  margin-top: 10px;
}

nav {
  display: flex;
  gap: 23px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

nav a {
  font-size: 9px;
  letter-spacing: 2px;
  position: relative;
}

nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 0;
  height: 1px;
  background: var(--dark-pink);
  transition: .3s;
}

nav a:hover::after,
nav a.active::after {
  width: 100%;
}


/* HERO */

.book-hero {
  min-height: 700px;
  padding: 50px 7%;
  display: grid;
  grid-template-columns: 55% 45%;
  align-items: center;
}

.hero-image {
  height: 620px;
  overflow: hidden;
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-content {
  background: var(--vanilla);
  padding: 75px 60px;
  margin-left: -50px;
  position: relative;
  z-index: 2;
}

.eyebrow {
  color: var(--dark-pink);
  font-size: 9px;
  letter-spacing: 3px;
  margin-bottom: 25px;
}

.hero-content h1 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(65px, 7vw, 100px);
  font-weight: 400;
  line-height: .84;
}

.hero-content h1 i {
  color: var(--dark-pink);
}

.hero-content > p:not(.eyebrow) {
  color: var(--soft-brown);
  font-size: 12px;
  line-height: 2;
  margin: 35px 0;
}

.button {
  display: inline-block;
  background: var(--brown);
  color: white;
  padding: 16px 22px;
  font-size: 9px;
  letter-spacing: 2px;
}


/* CURRENTLY READING */

.reading {
  padding: 130px 7%;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-top: 1px solid var(--line);
  padding-top: 20px;
  margin-bottom: 65px;
}

.section-heading h2,
.loved h2,
.tbr-heading h2,
.book-month h2,
.book-notes h2,
.reading-mood h2 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(55px, 6vw, 85px);
  font-weight: 400;
  line-height: .88;
}

.section-heading h2 i,
.loved h2 i,
.tbr-heading h2 i,
.book-month h2 i,
.book-notes h2 i,
.reading-mood h2 i {
  color: var(--dark-pink);
}

.section-heading > span {
  font-size: 8px;
  letter-spacing: 2px;
  line-height: 1.8;
  text-align: right;
}

.reading-feature {
  display: grid;
  grid-template-columns: 45% 55%;
  align-items: center;
  background: var(--vanilla);
}

.book-cover {
  height: 600px;
}

.book-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.reading-info {
  padding: 70px;
}

.reading-info > span,
.month-text > span {
  color: var(--dark-pink);
  font-size: 8px;
  letter-spacing: 3px;
}

.reading-info h3 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(55px, 6vw, 80px);
  font-weight: 400;
  line-height: .88;
  margin: 25px 0;
}

.reading-info h3 i,
.month-text h3 i {
  color: var(--dark-pink);
}

.stars,
.month-rating {
  color: var(--dark-pink);
  letter-spacing: 4px;
  margin: 25px 0;
}

.reading-info > p {
  color: var(--soft-brown);
  font-size: 12px;
  line-height: 2;
  max-width: 400px;
}

.book-details {
  display: flex;
  gap: 50px;
  border-top: 1px solid #d5c5ba;
  margin-top: 40px;
  padding-top: 25px;
}

.book-details small {
  display: block;
  color: var(--dark-pink);
  font-size: 7px;
  letter-spacing: 2px;
  margin-bottom: 8px;
}

.book-details strong {
  font-size: 8px;
  letter-spacing: 1px;
}


/* LOVED */

.loved {
  padding: 130px 7%;
}

.loved > h2 {
  margin-bottom: 70px;
}

.book-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.book-image {
  height: 500px;
  overflow: hidden;
}

.book-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: .5s;
}

.book-grid article:hover img {
  transform: scale(1.04);
}

.book-grid article > span {
  display: block;
  color: var(--dark-pink);
  font-size: 8px;
  letter-spacing: 2px;
  margin-top: 20px;
}

.book-grid h3 {
  font-family: 'Playfair Display', serif;
  font-size: 25px;
  font-weight: 400;
  margin: 9px 0;
}

.book-grid article > p {
  color: var(--dark-pink);
  font-size: 10px;
}


/* TBR */

.tbr {
  background: var(--vanilla);
  padding: 130px 7%;
  display: grid;
  grid-template-columns: 40% 60%;
  gap: 70px;
}

.tbr-list {
  border-top: 1px solid #d5c5ba;
}

.tbr-list > div {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 15px;
  padding: 28px 0;
  border-bottom: 1px solid #d5c5ba;
}

.tbr-list span {
  color: var(--dark-pink);
  font-size: 9px;
}

.tbr-list strong {
  font-size: 9px;
  letter-spacing: 2px;
}

.tbr-list p {
  grid-column: 2;
  color: var(--soft-brown);
  font-family: 'Playfair Display', serif;
  font-size: 15px;
}


/* AUTHORS */

.authors {
  padding: 130px 7%;
  display: grid;
  grid-template-columns: 55% 45%;
  align-items: center;
}

.authors-image {
  height: 600px;
}

.authors-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.authors-content {
  padding: 60px;
}

.authors-content > p:first-child {
  color: var(--dark-pink);
  font-size: 9px;
  letter-spacing: 3px;
  margin-bottom: 25px;
}

.authors-content h2 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(50px, 6vw, 78px);
  font-weight: 400;
  line-height: .9;
  margin-bottom: 35px;
}

.authors-content h2 i {
  color: var(--dark-pink);
}

.authors-content > p:not(:first-child) {
  color: var(--soft-brown);
  font-size: 12px;
  line-height: 2;
  margin-bottom: 35px;
}

.author-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.author-list span {
  font-size: 9px;
  letter-spacing: 2px;
}


/* BOOK OF MONTH */

.book-month {
  background: var(--pink);
  padding: 130px 7%;
}

.book-month > p,
.book-notes > p,
.reading-mood > p {
  color: var(--dark-pink);
  font-size: 9px;
  letter-spacing: 3px;
  margin-bottom: 25px;
}

.month-card {
  margin-top: 70px;
  display: grid;
  grid-template-columns: 40% 60%;
  background: var(--cream);
}

.month-cover {
  height: 520px;
}

.month-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.month-text {
  padding: 70px;
  align-self: center;
}

.month-text h3 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(50px, 6vw, 75px);
  font-weight: 400;
  line-height: .9;
  margin: 25px 0;
}

.month-text p {
  color: var(--soft-brown);
  font-size: 12px;
  line-height: 2;
  max-width: 400px;
}


/* NOTES */

.book-notes {
  padding: 130px 7%;
  text-align: center;
}

.book-notes h2 {
  margin-bottom: 65px;
}

.note-card {
  max-width: 750px;
  margin: auto;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: 45px 25px;
}

.note-card > span {
  color: var(--dark-pink);
  font-size: 25px;
}

.note-card p {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  line-height: 1.7;
  margin: 20px 0;
}

.note-card small {
  font-size: 7px;
  letter-spacing: 2px;
  color: var(--soft-brown);
}


/* MOOD */

.reading-mood {
  background: var(--vanilla);
  padding: 130px 7%;
}

.reading-mood h2 {
  margin-bottom: 70px;
}

.moods {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid #d5c5ba;
  border-bottom: 1px solid #d5c5ba;
}

.moods > div {
  padding: 35px 25px;
  border-right: 1px solid #d5c5ba;
}

.moods > div:last-child {
  border-right: none;
}

.moods span {
  font-size: 23px;
}

.moods strong {
  display: block;
  font-size: 9px;
  letter-spacing: 2px;
  margin: 25px 0 10px;
}

.moods p {
  color: var(--soft-brown);
  font-family: 'Playfair Display', serif;
  font-size: 14px;
}


/* END */

.book-ending {
  background: var(--brown);
  color: var(--cream);
  text-align: center;
  padding: 130px 20px;
}

.book-ending > div {
  font-size: 35px;
  margin-bottom: 25px;
}

.book-ending h2 {
  font-family: 'DM Serif Display', serif;
  font-size: clamp(55px, 7vw, 90px);
  font-weight: 400;
  line-height: .88;
}

.book-ending h2 i {
  color: var(--pink);
}


/* FOOTER */

footer {
  background: var(--brown);
  color: var(--cream);
  text-align: center;
  padding: 65px 20px;
  border-top: 1px solid #6d5f5d;
}

.footer-logo {
  font-family: 'DM Serif Display', serif;
  font-size: 30px;
  letter-spacing: 2px;
}

footer p {
  margin: 15px auto 30px;
  font-size: 10px;
  color: #d9cbc5;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 25px;
  flex-wrap: wrap;
  margin-bottom: 35px;
}

.footer-links a {
  font-size: 8px;
  letter-spacing: 2px;
}

footer small {
  font-size: 7px;
  letter-spacing: 2px;
  color: #b9aaa4;
}


/* TABLET */

@media (max-width: 900px) {

  header {
    flex-direction: column;
  }

  nav {
    justify-content: center;
  }

  .book-hero,
  .reading-feature,
  .authors,
  .tbr,
  .month-card {
    grid-template-columns: 1fr;
  }

  .hero-content {
    margin: -40px 30px 0;
  }

  .book-grid {
    grid-template-columns: 1fr;
  }

  .book-image {
    height: 550px;
  }

  .moods {
    grid-template-columns: 1fr 1fr;
  }

  .moods > div:nth-child(2) {
    border-right: none;
  }

  .moods > div:nth-child(3),
  .moods > div:nth-child(4) {
    border-top: 1px solid #d5c5ba;
  }

}


/* MOBILE */

@media (max-width: 600px) {

  .top-note {
    font-size: 7px;
    letter-spacing: 2px;
  }

  header {
    padding: 28px 5%;
  }

  .logo {
    font-size: 25px;
  }

  nav {
    gap: 13px;
  }

  nav a {
    font-size: 7px;
  }

  .book-hero {
    padding: 25px 6%;
  }

  .hero-image {
    height: 450px;
  }

  .hero-content {
    padding: 55px 30px;
    margin: -30px 15px 0;
  }

  .reading,
  .loved,
  .authors,
  .book-notes,
  .reading-mood {
    padding: 90px 6%;
  }

  .section-heading {
    display: block;
  }

  .section-heading > span {
    display: block;
    margin-top: 25px;
    text-align: left;
  }

  .book-cover {
    height: 450px;
  }

  .reading-info {
    padding: 50px 30px;
  }

  .book-details {
    flex-direction: column;
    gap: 20px;
  }

  .tbr {
    padding: 90px 6%;
  }

  .authors-image {
    height: 450px;
  }

  .authors-content {
    padding: 50px 10px;
  }

  .book-month {
    padding: 90px 6%;
  }

  .month-cover {
    height: 450px;
  }

  .month-text {
    padding: 50px 30px;
  }

  .moods {
    grid-template-columns: 1fr;
  }

  .moods > div {
    border-right: none !important;
    border-bottom: 1px solid #d5c5ba;
  }

  .moods > div:last-child {
    border-bottom: none;
  }

}
